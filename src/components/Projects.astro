---
import { siteConfig } from "../config";

const allProjects = siteConfig.projects ?? [];
const hasProjects = allProjects.length > 0;

// Order in config.ts decides placement: first 3 = featured column,
// everything after = the scrollable "other projects" list.
const featured = allProjects.slice(0, 3);
const others = allProjects.slice(3);

// Aggregate every unique skill mentioned across all projects for the footer strip.
const allSkills = Array.from(
  new Set(allProjects.flatMap((p) => p.skills ?? []))
);
---

{
  hasProjects && (
    <section id="projects" class="p-16 md:p-24">
      <div>
        <div class="mb-12 lg:mb-16">
          <h2 class="text-5xl lg:text-7xl font-bold text-gray-900">
            Projects
          </h2>
          <div
            class="w-[75px] h-[5px] mt-2 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
        </div>

        {/* ---------- Tiled layout: featured column + scrollable "other" column ---------- */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 lg:h-[860px]">
          {/* Featured column */}
          <div class="lg:col-span-7 flex flex-col gap-6 lg:h-full">
            {featured.map((project, index) => {
              const isTopFeatured = index === 0;
              const Component = project.link ? "a" : "div";
              const linkProps = project.link
                ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
                : {};

              return (
                <Component
                  {...linkProps}
                  class="featured-tile group relative flex flex-1 flex-col justify-between overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 p-8 transition-all duration-300 hover:bg-white hover:shadow-xl hover:border-gray-300"
                >
                  {isTopFeatured && (
                    <div
                      class="absolute top-4 left-4 z-40 flex h-11 w-11 items-center justify-center rounded-full shadow-lg ring-4 ring-white/70"
                      style={`background-color: ${siteConfig.accentColor}`}
                      title="Top featured project"
                      aria-label="Top featured project"
                    >
                      <svg
                        class="h-5 w-5 text-white"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M2.5 8.5l4.5 3 5-6 5 6 4.5-3-2 10.5h-15l-2-10.5z" />
                      </svg>
                    </div>
                  )}

                  {project.link && (
                    <div class="absolute top-6 right-6 z-30 flex h-10 w-10 items-center justify-center rounded-full bg-gray-900 text-white transition-all duration-300 group-hover:bg-gray-700">
                      <svg
                        class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M7 17L17 7M17 7H7M17 7V17"
                        />
                      </svg>
                    </div>
                  )}

                  <div class={`relative z-20 space-y-3 pr-10 ${isTopFeatured ? "pt-8" : ""}`}>
                    <span
                      class="text-xs font-mono uppercase tracking-widest"
                      style={{ color: siteConfig.accentColor }}
                    >
                      Featured 
                    </span>
                    <h3 class="text-2xl font-bold text-gray-900">
                      {project.name}
                    </h3>
                    <p class="text-base text-gray-600 leading-relaxed">
                      {project.description}
                    </p>

                    {project.skills && project.skills.length > 0 && (
                      <div class="flex flex-wrap gap-2 pt-1">
                        {project.skills.map((skill) => (
                          <span class="px-2.5 py-1 bg-gray-900 text-white rounded-md text-xs font-medium transition-all duration-300 group-hover:bg-gray-800">
                            {skill}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>

                  {/* Peeking preview image, bottom-left corner */}
                  <div class="featured-tile-image-wrap pointer-events-none absolute inset-0 z-10 overflow-hidden">
                    {project.image ? (
                      <img
                        src={project.image}
                        alt=""
                        aria-hidden="true"
                        class="featured-tile-image"
                      />
                    ) : (
                      <div class="featured-tile-image flex items-center justify-center rounded-xl bg-gradient-to-br from-gray-200 to-gray-300">
                        <svg
                          class="w-10 h-10 text-gray-400"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                          />
                        </svg>
                      </div>
                    )}
                  </div>
                </Component>
              );
            })}
          </div>

          {/* Other projects — scrollable list */}
          <div class="lg:col-span-5 lg:h-full">
            {others.length > 0 ? (
              <div class="other-projects-scroll flex h-full flex-col rounded-2xl border border-gray-200 bg-gray-50/60 lg:overflow-y-auto">
                <div class="sticky top-0 z-10 border-b border-gray-200 bg-gray-50/95 px-6 py-4 backdrop-blur-sm">
                  <span class="text-xs font-mono uppercase tracking-widest text-gray-500">
                    More Projects · {others.length}
                  </span>
                </div>
                <div class="space-y-3 p-4 lg:p-5">
                  {others.map((project) => {
                    const Component = project.link ? "a" : "div";
                    const linkProps = project.link
                      ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
                      : {};
                    const visibleSkills = project.skills?.slice(0, 3) ?? [];
                    const extraSkillCount = (project.skills?.length ?? 0) - visibleSkills.length;

                    return (
                      <Component
                        {...linkProps}
                        class={`group/other flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 transition-all duration-300 ${
                          project.link
                            ? "hover:border-gray-300 hover:shadow-md hover:-translate-y-0.5"
                            : ""
                        }`}
                      >
                        <div class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-gray-100">
                          {project.image ? (
                            <img
                              src={project.image}
                              alt={`${project.name} icon`}
                              class="h-full w-full object-contain mix-blend-multiply"
                            />
                          ) : (
                            <svg
                              class="h-6 w-6 text-gray-400"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                              />
                            </svg>
                          )}
                        </div>

                        <div class="min-w-0 flex-1">
                          <h4 class="truncate text-base font-semibold text-gray-900">
                            {project.name}
                          </h4>
                          <p class="other-project-desc mt-0.5 text-sm text-gray-500">
                            {project.description}
                          </p>
                          {visibleSkills.length > 0 && (
                            <div class="mt-2 flex flex-wrap items-center gap-1.5">
                              {visibleSkills.map((skill) => (
                                <span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700">
                                  {skill}
                                </span>
                              ))}
                              {extraSkillCount > 0 && (
                                <span class="text-xs font-medium text-gray-400">
                                  +{extraSkillCount}
                                </span>
                              )}
                            </div>
                          )}
                        </div>

                        {project.link && (
                          <svg
                            class="h-4 w-4 shrink-0 text-gray-300 transition-all duration-300 group-hover/other:text-gray-500 group-hover/other:translate-x-0.5 group-hover/other:-translate-y-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        )}
                      </Component>
                    );
                  })}
                </div>
              </div>
            ) : (
              <div class="flex h-full min-h-[200px] items-center justify-center rounded-2xl border border-dashed border-gray-300 p-8 text-center">
                <p class="text-sm text-gray-400">
                  More projects will appear here as they're added.
                </p>
              </div>
            )}
          </div>
        </div>

        {/* ---------- Aggregated skills strip ---------- */}
        {allSkills.length > 0 && (
          <div class="mt-10 lg:mt-12 pt-8 border-t border-gray-200">
            <span class="text-xs font-mono uppercase tracking-widest text-gray-400">
              Skills &amp; Tools
            </span>
            <div class="mt-4 flex flex-wrap gap-3">
              {allSkills.map((skill) => (
                <span class="px-4 py-2 bg-gray-100 text-gray-800 rounded-full text-sm font-medium hover:bg-gray-200 transition-colors duration-200">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  /* Featured tile preview image: sits fixed in the bottom-right corner at all
     times (never slides or resizes) and simply overlays more strongly —
     fading from a faint watermark to a fuller-opacity overlay — on hover/focus. */
  .featured-tile-image-wrap {
    border-radius: inherit;
  }

  .featured-tile-image {
    position: absolute;
    right: -25%;
    bottom: -8%;
    width: 68%;
    height: 68%;
    object-fit: contain;
    mix-blend-mode: multiply;
    opacity: 0.22;
    transition: opacity 0.45s ease;
  }

  .featured-tile:hover .featured-tile-image,
  .featured-tile:focus-within .featured-tile-image {
    opacity: 0.95;
  }

  /* Two-line clamp for compact "other project" descriptions */
  .other-project-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Slim, quiet scrollbar for the "other projects" panel */
  .other-projects-scroll {
    scrollbar-width: thin;
    scrollbar-color: #d1d5db transparent;
  }
  .other-projects-scroll::-webkit-scrollbar {
    width: 8px;
  }
  .other-projects-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .other-projects-scroll::-webkit-scrollbar-thumb {
    background-color: #d1d5db;
    border-radius: 9999px;
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-tile-image {
      transition: none;
    }
  }
</style>